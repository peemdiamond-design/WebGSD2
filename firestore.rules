rules_version = '2';

// Firestore Security Rules — โปรเจกต์ gsd2-532a1
// หลักการ: ปิดทุกอย่างเป็นค่าเริ่มต้น แล้วเปิดเฉพาะที่จำเป็น
//
// เจ้าหน้าที่ (staff) = ผู้ใช้ที่ล็อกอินแล้ว และมีเอกสาร /staff/{uid} อยู่
// (เพิ่ม/ลบเจ้าหน้าที่ได้จาก Firebase Console เท่านั้น — เว็บเขียนคอลเลกชันนี้ไม่ได้)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function str(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function httpsOrEmpty(v, maxLen) {
      return str(v, maxLen) && (v == '' || v.matches('https://.+'));
    }

    // ---------- รายชื่อเจ้าหน้าที่ ----------
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;  // อ่านได้เฉพาะของตัวเอง
      allow write: if false;                                  // จัดการผ่าน Console เท่านั้น
    }

    // ---------- ข้อมูลสาธารณะ (public/stats ของหน้าสถิติ) ----------
    match /public/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---------- ข่าวสาร / ประกาศ (หน้า "ข่าวสาร") ----------
    match /bulletins/{id} {
      allow read: if true;
      allow delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['title', 'summary', 'body', 'category', 'imageUrl', 'publishedAt', 'updatedAt', 'authorUid'])
        && request.resource.data.keys().hasAll(['title', 'category', 'publishedAt'])
        && str(request.resource.data.title, 200) && request.resource.data.title.size() > 0
        && str(request.resource.data.get('summary', ''), 500)
        && str(request.resource.data.get('body', ''), 20000)
        && request.resource.data.category in ['news', 'alert', 'wanted']
        && httpsOrEmpty(request.resource.data.get('imageUrl', ''), 2000)
        && request.resource.data.publishedAt is timestamp;
    }

    // ---------- คลังเอกสารสาธารณะ (ลิงก์ไปยังไฟล์ เช่น Nextcloud / Google Drive) ----------
    match /documents/{id} {
      allow read: if true;
      allow delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['code', 'title', 'url', 'fileType', 'category', 'updatedAt'])
        && request.resource.data.keys().hasAll(['title', 'url'])
        && str(request.resource.data.title, 300) && request.resource.data.title.size() > 0
        && str(request.resource.data.url, 2000) && request.resource.data.url.matches('https://.+')
        && str(request.resource.data.get('code', ''), 40)
        && str(request.resource.data.get('fileType', ''), 10)
        && str(request.resource.data.get('category', ''), 80);
    }

    // ---------- เบาะแสจากประชาชน ----------
    match /clue_reports/{reportId} {
      // ใครก็ส่งได้ (ไม่ต้องล็อกอิน) แต่ต้องมีรูปแบบถูกต้องเท่านั้น
      allow create: if
        request.resource.data.keys().hasOnly(['type', 'details', 'contact', 'createdAt'])
        && request.resource.data.keys().hasAll(['type', 'details', 'contact', 'createdAt'])
        && request.resource.data.type in ['ความมั่นคงแนวชายแดน', 'ยาเสพติด/สิ่งผิดกฎหมาย', 'อื่นๆ']
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 5000
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 200
        && request.resource.data.createdAt == request.time;

      // ประชาชนอ่าน/แก้/ลบไม่ได้ — เฉพาะเจ้าหน้าที่อ่านและลบได้
      allow read, delete: if isStaff();

      // เจ้าหน้าที่แก้ได้เฉพาะช่องสถานะ/บันทึกภายใน ห้ามแก้เนื้อหาเบาะแส
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'staffNote', 'updatedAt'])
        && request.resource.data.get('status', 'new') in ['new', 'reviewing', 'closed']
        && str(request.resource.data.get('staffNote', ''), 2000);
    }

    // ---------- อย่างอื่นทั้งหมด: ปิด ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
